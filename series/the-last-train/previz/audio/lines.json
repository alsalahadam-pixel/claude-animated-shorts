[
  {"id": 1, "who": "kai", "fx": "vo", "start": 0.2, "max": 2.3, "text": "The last train came in at two seventeen."},
  {"id": 2, "who": "kai", "fx": "vo", "start": 3.0, "max": 1.6, "text": "Nobody got off.", "len": 1.25},
  {"id": 3, "who": "kai", "fx": "room", "start": 5.6, "max": 1.5, "text": "Last stop, folks."},
  {"id": 4, "who": "kai", "fx": "vo", "start": 7.9, "max": 3.2, "text": "Night shift. Usually the worst thing down here is a drunk."},
  {"id": 5, "who": "kai", "fx": "room", "start": 13.7, "max": 1.6, "text": "Ma'am? You okay?", "len": 1.35},
  {"id": 6, "who": "pa", "fx": "pa", "start": 15.75, "max": 5.6, "text": "Emergency announcement. All services are suspended. Remain where you are. Help is on the way."},
  {"id": 7, "who": "ruth", "fx": "radio_loud", "start": 21.7, "max": 1.25, "text": "Kai! Kai, pick up!"},
  {"id": 8, "who": "ruth", "fx": "radio", "start": 30.4, "max": 3.2, "text": "Control's sealing the stations. Shutters drop at two twenty one. Get out."},
  {"id": 9, "who": "kai", "fx": "whisper", "start": 33.7, "max": 1.1, "text": "There's people on the train."},
  {"id": 10, "who": "ruth", "fx": "radio", "start": 34.85, "max": 1.35, "text": "They're not people anymore. Run."},
  {"id": 11, "who": "lucy", "fx": "phone", "start": 41.2, "max": 3.6, "text": "Kai? Mum's still at the hospital. Someone's knocking. He won't stop knocking."},
  {"id": 12, "who": "kai", "fx": "vo", "start": 45.0, "max": 2.9, "text": "My little sister. Home alone. Four stops away."},
  {"id": 13, "who": "wren", "fx": "steel", "start": 53.0, "max": 2.0, "text": "Hello? Is someone there?", "len": 1.2},
  {"id": 14, "who": "wren", "fx": "whisper", "start": 55.9, "max": 1.9, "text": "Please. A lady locked us in."},
  {"id": 15, "who": "kai", "fx": "whisper", "start": 58.0, "max": 0.6, "text": "Us?", "len": 2.2},
  {"id": 16, "who": "wren", "fx": "whisper", "start": 58.85, "max": 1.4, "text": "Me. Just me."},
  {"id": 17, "who": "kai", "fx": "whisper", "start": 63.4, "max": 0.9, "text": "What's your name?", "len": 1.2},
  {"id": 18, "who": "wren", "fx": "steel_w", "start": 64.45, "max": 0.6, "text": "Wren.", "len": 1.6},
  {"id": 19, "who": "kai", "fx": "whisper", "start": 69.6, "max": 1.9, "text": "Wren. Who's in there with you?", "len": 1.35},
  {"id": 20, "who": "wren", "fx": "whisper", "start": 72.05, "max": 0.9, "text": "Nobody.", "len": 1.45},
  {"id": 21, "who": "kai", "fx": "vo", "start": 76.3, "max": 2.4, "text": "Lucy's waiting for me. So is she."},
  {"id": 22, "who": "kai", "fx": "whisper", "start": 80.6, "max": 1.2, "text": "What do I do?", "len": 1.3},
  {"id": 23, "who": "kai", "fx": "vo_whisper", "start": 83.4, "max": 2.9, "text": "Would you open the door? A, or B?", "len": 1.25}
